{
  "name": "invoice-product",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "version": "0.1.0",
  "description": "India-first accounting and business operations platform",
  "workspaces": [
    "apps/*",
    "ops/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "docker compose up -d --wait db && npm install && npm run db:migrate && npm run db:seed && npm run verify",
    "dev": "node --experimental-strip-types apps/api/src/server.ts",
    "web": "node --experimental-strip-types apps/web/server.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"apps/*/test/**/*.test.ts\" \"ops/*/test/**/*.test.ts\" \"packages/*/test/**/*.test.ts\" \"tests/e2e/**/*.test.ts\" \"tools/test/**/*.test.ts\"",
    "test:integration": "node --experimental-strip-types --test packages/platform/test/*.integration.test.ts",
    "security:drill": "node --test --experimental-strip-types ops/security/test/security.test.ts",
    "gates": "node --experimental-strip-types packages/release-gates/src/cli.ts",
    "verify": "npm run lint && npm run test && npm run test:integration && npm run gates",
    "check": "npm run verify",
    "db:migrate": "node --experimental-strip-types packages/platform/src/migrations.ts up",
    "db:rollback": "node --experimental-strip-types packages/platform/src/migrations.ts down",
    "db:migration:id": "node --experimental-strip-types tools/migrations/new-id.ts",
    "db:seed": "node --experimental-strip-types packages/platform/src/seed.ts",
    "demo:masters": "node --experimental-strip-types packages/masters/src/demo.ts",
    "demo:inbox": "node --experimental-strip-types packages/purchasing/src/demo.ts",
    "demo:invoice": "node --experimental-strip-types packages/invoice-templates/src/demo.ts",
    "demo:validate": "node --experimental-strip-types packages/purchasing/src/validation-demo.ts",
    "demo:onboarding": "node --experimental-strip-types packages/onboarding/src/demo.ts",
    "demo:reports": "node --experimental-strip-types packages/reports/src/demo.ts",
    "demo:posting": "node --experimental-strip-types packages/purchasing/src/posting-demo.ts",
    "demo:matching": "node --experimental-strip-types packages/purchasing/src/matching-demo.ts",
    "demo:risk": "node --experimental-strip-types packages/purchasing/src/supplier-risk-demo.ts",
    "demo:einvoice": "node --experimental-strip-types packages/gst/src/einvoice-demo.ts",
    "demo:eway": "node --experimental-strip-types packages/transport/src/demo.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.16.3",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.0"
  }
}
