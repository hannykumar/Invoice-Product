{
  "name": "invoice-product",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "node --test --experimental-strip-types \"packages/*/test/**/*.test.ts\" \"tools/test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
