{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["apps/**/*.ts", "ops/**/*.ts", "packages/**/*.ts", "tests/browser/**/*.ts", "tools/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "**/dist"]
}
