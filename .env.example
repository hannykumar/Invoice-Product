NODE_ENV=development
DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoice
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-a-32-byte-secret
CONNECTOR_VAULT_MODE=development

# Sign-in (#342, ADR D1): Supabase Auth, project in Mumbai (ap-south-1), asymmetric JWT signing keys on.
# Leave both empty on a developer's machine: the demo sign-in then accepts the code in
# packages/platform/src/seed.ts. Outside NODE_ENV=development/test the server refuses to start without them.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# WhiteBooks (formerly MasterGST) GSP sandbox. Sandbox credentials only — .env is gitignored.
WHITEBOOKS_BASE_URL=https://apisandbox.whitebooks.in
WHITEBOOKS_GST_CLIENT_ID=
WHITEBOOKS_GST_CLIENT_SECRET=
WHITEBOOKS_EINVOICE_CLIENT_ID=
WHITEBOOKS_EINVOICE_CLIENT_SECRET=
WHITEBOOKS_EWAYBILL_CLIENT_ID=
WHITEBOOKS_EWAYBILL_CLIENT_SECRET=
WHITEBOOKS_GSTIN=
WHITEBOOKS_USERNAME=
WHITEBOOKS_PASSWORD=
